@startuml
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

'==== Persons ====
Person(customer, "Клиент", "Пользователь онлайн-банка/сайта банка")
Person(bo, "Менеджер бэк-офиса депозитов", "Обработка заявок")
Person(cc, "Оператор кол-центра", "Звонки и обработка заявок")
Person(cr, "Сотрудник кредитного отдела", "Подтверждение спецставок")

'==== Systems ====
System_Ext(website, "Сайт банка", "Подача заявок на депозиты для новых клиентов")
System(ib, "Интернет-банк", "Действующий онлайн-банк для клиентов")
System(mvp, "Модуль депозитов (MVP)", "Новый модуль/сервис для обработки заявок и ставок")
System(offer, "Модуль ставок/админка", "Хранилище и обработка депозитных ставок")
System(abc, "АБС", "Банковская автоматизированная система (Delphi/Oracle)")
System_Ext(sms, "СМС-шлюз", "Оповещения клиентов по СМС")
System_Ext(crm, "Система кол-центра", "Обращения и обзвон клиентов (CRM)")

'==== Relationships ====
Rel(customer, website, "Подаёт заявку на депозит (новый клиент)")
Rel(customer, ib, "Открывает депозит онлайн (действующий клиент)")
Rel(website, mvp, "Передаёт заявку")
Rel(ib, mvp, "Передаёт заявку")
Rel(mvp, offer, "Запрашивает ставки/условия")
Rel(bo, mvp, "Обрабатывает заявки и подтверждает открытие", "Web-интерфейс")
Rel(mvp, abc, "Создание депозитов, обмен данными", "API")
Rel(mvp, sms, "Отправка СМС с условиями и подтверждением")
Rel(mvp, crm, "Передача заявок новых клиентов")
Rel(cc, crm, "Работает с заявками", "Web-интерфейс CRM")
Rel(bo, offer, "Работает с ставками", "Админка/хранилище")
Rel(cr, offer, "Согласовывает спецставки", "Through backstage")
Rel(abc, sms, "Отправка СМС", "По старым процессам")

@enduml